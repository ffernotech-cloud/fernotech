          "value": "\"deliveries\".\"received_kg\" > 0"
        },
        "deliveries_sort_balance": {
          "name": "deliveries_sort_balance",
          "value": "(\"deliveries\".\"status\" = 'recue' AND \"deliveries\".\"accepted_kg\" IS NULL AND \"deliveries\".\"rejected_kg\" IS NULL) OR (\"deliveries\".\"status\" IN ('triee', 'integree_au_stock') AND \"deliveries\".\"accepted_kg\" IS NOT NULL AND \"deliveries\".\"rejected_kg\" IS NOT NULL AND \"deliveries\".\"accepted_kg\" >= 0 AND \"deliveries\".\"rejected_kg\" >= 0 AND \"deliveries\".\"accepted_kg\" + \"deliveries\".\"rejected_kg\" = \"deliveries\".\"received_kg\")"
