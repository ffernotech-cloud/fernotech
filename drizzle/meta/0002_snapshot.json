          "name": "deliveries_rejection_reason",
          "value": "\"deliveries\".\"rejected_kg\" IS NULL OR \"deliveries\".\"rejected_kg\" = 0 OR \"deliveries\".\"rejection_reason\" IS NOT NULL"
        }
